## Audio autoload: music loop, UI/feedback sounds (non-positional) and 3D sounds at a position.
## Sounds are generated by tools/build_audio.py into assets/audio/. Ctrl+M toggles music.
extends Node

const DIR := "res://assets/audio/"
const MUSIC_DB := -16.0
const SFX_DB := -6.0

var _streams := {}
var _music: AudioStreamPlayer
var _ui_pool: Array[AudioStreamPlayer] = []
var _music_on := true
var _last_played := {} # name -> msec, to avoid machine-gunning the same sound


func _ready() -> void:
	if not GameData.visuals_enabled():
		return
	for i in range(8):
		var p := AudioStreamPlayer.new()
		p.volume_db = SFX_DB
		add_child(p)
		_ui_pool.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = MUSIC_DB
	add_child(_music)
	_music.finished.connect(func() -> void:
		if _music_on and _music.stream:
			_music.play())
	_music_on = bool(Settings.get_value("audio", "music", true))


func _stream(name: String) -> AudioStream:
	if _streams.has(name):
		return _streams[name]
	var s: AudioStream = null
	for ext in ["ogg", "wav"]:
		var path: String = DIR + name + "." + ext
		if ResourceLoader.exists(path):
			s = load(path)
			break
	_streams[name] = s
	return s


func _throttled(name: String, min_gap_ms: int) -> bool:
	var t := Time.get_ticks_msec()
	if t - int(_last_played.get(name, -99999)) < min_gap_ms:
		return true
	_last_played[name] = t
	return false


## Non-positional (UI, own feedback).
func play(name: String, volume_db := 0.0, pitch_jitter := 0.05, min_gap_ms := 40) -> void:
	if _ui_pool.is_empty() or _throttled(name, min_gap_ms):
		return
	var s := _stream(name)
	if s == null:
		return
	for p in _ui_pool:
		if not p.playing:
			p.stream = s
			p.volume_db = SFX_DB + volume_db
			p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
			p.play()
			return
	# All busy: steal the first.
	var p0: AudioStreamPlayer = _ui_pool[0]
	p0.stream = s
	p0.volume_db = SFX_DB + volume_db
	p0.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p0.play()


## Positional one-shot in the world.
func play_at(name: String, pos: Vector3, volume_db := 0.0, pitch_jitter := 0.06, min_gap_ms := 40) -> void:
	if _music == null or _throttled(name + "@", min_gap_ms):
		return
	var s := _stream(name)
	if s == null:
		return
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.volume_db = SFX_DB + 2.0 + volume_db
	p.unit_size = 6.0
	p.max_distance = 45.0
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	get_tree().current_scene.add_child(p)
	p.global_position = pos
	p.finished.connect(p.queue_free)
	p.play()


## Looping positional sound (campfire). Returns the player so the caller can free it.
func loop_at(name: String, parent: Node3D, volume_db := 0.0, max_distance := 25.0) -> AudioStreamPlayer3D:
	var s := _stream(name)
	if s == null or _music == null:
		return null
	if s is AudioStreamOggVorbis:
		s.loop = true
	elif s is AudioStreamWAV:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.volume_db = SFX_DB + volume_db
	p.unit_size = 4.0
	p.max_distance = max_distance
	p.autoplay = true
	parent.add_child(p)
	p.play()
	return p


func start_music(name := "music_camp") -> void:
	if _music == null:
		return
	var s := _stream(name)
	if s == null:
		return
	if s is AudioStreamOggVorbis:
		s.loop = true
	_music.stream = s
	if _music_on:
		_music.play()


func toggle_music() -> void:
	_music_on = not _music_on
	if _music:
		if _music_on:
			_music.play()
		else:
			_music.stop()
	Settings.set_value("audio", "music", _music_on)


func music_enabled() -> bool:
	return _music_on


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and event.ctrl_pressed and not event.echo and event.keycode == KEY_M:
		toggle_music()
		get_viewport().set_input_as_handled()
